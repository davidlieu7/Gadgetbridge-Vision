<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- The keys here must be the generic Gadgetbridge ones: onSendConfiguration
         is only invoked for preference keys DeviceSpecificSettingsFragment
         registers a change handler for, and that list is a fixed set of known
         keys - a device-specific key would silently never be pushed. -->

    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:icon="@drawable/ic_vibration"
        android:key="vibration_enable"
        android:layout="@layout/preference_checkbox"
        android:summary="@string/enable_vibrations_summary"
        android:title="@string/prefs_vibration_enable" />

    <!-- The band knows two levels only, so the generic two-value list fits. -->
    <ListPreference
        android:defaultValue="normal"
        android:entries="@array/vibration_intensity"
        android:entryValues="@array/vibration_intensity_values"
        android:key="vibration_intensity"
        app:useSimpleSummaryProvider="true"
        android:title="@string/pref_vibration_intensity" />

    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:icon="@drawable/ic_brightness_auto"
        android:key="screen_auto_brightness"
        android:layout="@layout/preference_checkbox"
        android:summary="@string/pref_screen_auto_brightness_summary"
        android:title="@string/pref_screen_auto_brightness_title" />

    <!-- The band has ten brightness steps, not a percentage. -->
    <SeekBarPreference
        android:defaultValue="5"
        android:icon="@drawable/ic_brightness_medium"
        android:key="screen_brightness"
        android:max="10"
        android:min="1"
        android:title="@string/pref_screen_brightness"
        app:showSeekBarValue="true" />

    <ListPreference
        android:defaultValue="10"
        android:entries="@array/samsung_fit3_screen_timeout"
        android:entryValues="@array/samsung_fit3_screen_timeout_values"
        android:icon="@drawable/ic_hourglass_empty"
        android:key="screen_timeout"
        app:useSimpleSummaryProvider="true"
        android:title="@string/prefs_screen_timeout" />

    <!-- Device-specific keys from here on: SamsungFit3SettingsCustomizer
         registers a change handler for each. Values are the band's own list
         indices. -->
    <ListPreference
        android:defaultValue="1"
        android:entries="@array/samsung_fit3_double_press"
        android:entryValues="@array/samsung_fit3_double_press_values"
        android:icon="@drawable/ic_touch_double"
        android:key="samsung_fit3_double_press"
        app:useSimpleSummaryProvider="true"
        android:title="@string/pref_samsung_fit3_double_press_title" />

    <ListPreference
        android:defaultValue="0"
        android:entries="@array/samsung_fit3_disconnection_alert"
        android:entryValues="@array/samsung_fit3_disconnection_alert_values"
        android:icon="@drawable/ic_bluetooth_disabled"
        android:key="samsung_fit3_disconnection_alert"
        app:useSimpleSummaryProvider="true"
        android:title="@string/pref_samsung_fit3_disconnection_alert_title" />

    <ListPreference
        android:defaultValue="0"
        android:entries="@array/samsung_fit3_status_indicator"
        android:entryValues="@array/samsung_fit3_status_indicator_values"
        android:icon="@drawable/ic_notifications"
        android:key="samsung_fit3_status_indicator"
        app:useSimpleSummaryProvider="true"
        android:title="@string/pref_samsung_fit3_status_indicator_title" />

</androidx.preference.PreferenceScreen>
