<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:icon="@drawable/ic_settings_applications"
        android:key="garmin_experimental_app_management"
        android:layout="@layout/preference_checkbox"
        android:summary="Allow installed app management from Gadgetbridge. Not heavily tested. Uninstalling system apps might be dangerous."
        android:title="App management" />
    <PreferenceCategory
        android:title="SleepTest"
        app:iconSpaceReserved="false">
        <nodomain.freeyourgadget.gadgetbridge.util.XTimePreference
            android:icon="@drawable/ic_bedtime_on"
            android:key="garmin_experimental_sleep_SleepTime"
            android:title="Sleep Time"
            app:defaultValue="22:00"
            app:useSimpleSummaryProvider="true" />
        <nodomain.freeyourgadget.gadgetbridge.util.XTimePreference
            android:icon="@drawable/ic_bedtime_off"
            android:key="garmin_experimental_sleep_WakeTime"
            android:title="Wake Time"
            app:defaultValue="06:00"
            app:useSimpleSummaryProvider="true" />
        <Preference
            android:icon="@drawable/ic_send"
            android:key="garmin_experimental_sleep_send"
            android:summary="Click this to try to send the above typical wake and sleep times to the gadget."
            android:title="Send Sleep Settings" />
    </PreferenceCategory>
    <PreferenceCategory
        android:title="ConnectionTest"
        app:iconSpaceReserved="false">
        <ListPreference
            android:defaultValue="-2"
            android:entries="@array/fit_settings_bool_labels"
            android:entryValues="@array/fit_settings_bool_values"
            android:icon="@drawable/ic_wifi"
            android:key="garmin_experimental_connection_Wifi"
            android:title="Wifi"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:defaultValue="-2"
            android:entries="@array/fit_settings_bool_labels"
            android:entryValues="@array/fit_settings_bool_values"
            android:icon="@drawable/ic_file_upload"
            android:key="garmin_experimental_connection_WifiAutoUpload"
            android:title="Wifi Auto Upload"
            app:useSimpleSummaryProvider="true" />
        <Preference
            android:icon="@drawable/ic_send"
            android:key="garmin_experimental_connection_send"
            android:summary="Click this to try to set the above connection settings."
            android:title="Send Connection Settings" />
    </PreferenceCategory>
    <PreferenceCategory
        android:title="CGM"
        app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:icon="@drawable/ic_monitor_weight"
            android:key="garmin_experimental_cgm_hc_proxy"
            android:layout="@layout/preference_checkbox"
            android:summary="Serve /sgv.json and the xDrip+ treatments endpoints for CGM+ watch apps directly from Health Connect (values written by any xDrip+ compatible CGM source, e.g. Juggluco), with no loopback socket and no internet permission — avoiding the cross-app socket failures (EPERM) a Juggluco proxy hits. Requires the Health Connect permission to read glucose (and carbs, for treatments). For personal information only — not intended for medical treatment."
            android:title="xDrip+ Health Connect Proxy" />
    </PreferenceCategory>
</androidx.preference.PreferenceScreen>
